# Copy to .env  (cp .env.example .env)

# RTSP URL of the camera. Leave empty and use "Find streams (ONVIF)" in the GUI instead.
# Use the SUB-stream (low resolution) - plenty for shirt colors.
CAMERA_URL=

# Optional password for the web GUI (username can be anything).
# The ESP32 endpoint /api/display stays open so the tag can poll it.
ADMIN_PASSWORD=
